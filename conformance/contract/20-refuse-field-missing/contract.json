{
  "expect": [
    {
      "select": "h1",
      "equals": "All products"
    }
  ],
  "fields": {
    "books": {
      "select": "article.product",
      "match": "all",
      "max": 100,
      "fields": {
        "id": {
          "read": "attr:id"
        },
        "title": {
          "select": "h3 a",
          "read": "attr:title"
        },
        "price": {
          "select": ".price",
          "pattern": "^£(?<value>[0-9]+\\.[0-9]{2})$"
        },
        "rating": {
          "select": ".star-rating",
          "read": "attr:class",
          "pattern": "^star-rating (?<value>One|Two|Three|Four|Five)$"
        },
        "stock": ".availability",
        "badge": {
          "select": ".badge",
          "match": "optional"
        },
        "url": {
          "select": "h3 a",
          "read": "url:href"
        }
      }
    }
  }
}
