{
  "expect": [
    {
      "select": "h1",
      "equals": "Warehouse 7"
    }
  ],
  "select": "article",
  "match": "all",
  "min": 2,
  "max": 2,
  "fields": {
    "id": {
      "read": "attr:data-id"
    },
    "title": "h2",
    "price": {
      "select": "dt",
      "where": [
        {
          "equals": "Price"
        }
      ],
      "until": "dt",
      "fields": {
        "amount": {
          "select": "dd",
          "pattern": "^£(?<value>[0-9]+\\.[0-9]{2})$"
        }
      }
    },
    "stock": {
      "select": "dt",
      "where": [
        {
          "equals": "Stock"
        }
      ],
      "until": "dt",
      "fields": {
        "amount": "dd"
      }
    },
    "tags": {
      "select": "li",
      "match": "all"
    },
    "badge": {
      "select": ".badge",
      "match": "optional"
    },
    "url": {
      "select": "a",
      "read": "url:href"
    }
  }
}
